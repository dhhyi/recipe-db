{
  "name": "design",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && cp node_modules/htmx.org/dist/htmx.min.js dist/design/htmx.min.js && cp node_modules/htmx.org/LICENSE dist/design/htmx.LICENSE && pnpm build-storybook --output-dir dist/storybook && cp -R dist/storybook/. dist/design/ && rm -rf dist/storybook",
    "preview": "vite preview",
    "start": "storybook dev -p 6006 --no-open",
    "lint": "eslint .",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@anyblades/blades": "3.0.0-alpha.3",
    "lit": "^3.3.3",
    "lorem-ipsum": "^3.0.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@storybook/web-components-vite": "^10.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^10.9.1",
    "eslint-plugin-storybook": "^10.5.10",
    "htmx.org": "2.0.10",
    "http-server": "^14.1.1",
    "storybook": "^10.5.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "error"
    }
  }
}
