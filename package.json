{
  "name": "recipe-db",
  "repository": "github:dhhyi/recipe-db",
  "scripts": {
    "install-precommit": "echo 'PRE_COMMIT=1 node .scripts/precommit.js \"$@\"' > .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit",
    "prepare": "pnpm run install-precommit && pnpm run synchronize && mise run generate-docker-compose prepare",
    "synchronize": "node .scripts/create-intranet.js && node .scripts/synchronize.js && node .scripts/merge-graphql-schemas.js && pnpm run pin-docker-images",
    "pin-docker-images": "node .scripts/pin-docker-images.js",
    "in-devcontainer": "node .scripts/run-in-devcontainer.js",
    "seed-demodata": "docker compose --profile development run --build --rm -e FORCE_DELETE demo-data"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@anyblades/blades": "3.0.0-alpha.3",
    "@eslint/js": "^10.0.1",
    "@prettier/plugin-xml": "^3.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.0.0",
    "prettier-plugin-sh": "^0.13.1",
    "prettier-plugin-toml": "^3.0.2",
    "tailwindcss": "4.3.3"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "error"
    }
  },
  "license": "MIT"
}
