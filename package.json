{
  "name": "recipe-db",
  "repository": "github:dhhyi/recipe-db",
  "scripts": {
    "prepare": "husky install && npm run synchronize && npm run generate-docker-compose prepare",
    "synchronize": "node .scripts/create-intranet.js && node .scripts/synchronize.js && node .scripts/merge-graphql-schemas.js && npm run pin-docker-images",
    "pin-docker-images": "node .scripts/pin-docker-images.js",
    "in-devcontainer": "node .scripts/run-in-devcontainer.js",
    "generate-docker-compose": "node .scripts/merge-graphql-schemas.js && node .scripts/generate-docker-compose.js",
    "seed-demodata": "docker compose --profile development run --build --rm -e FORCE_DELETE demo-data"
  },
  "dependencies": {
    "glob": "^10.3.3",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@anyblades/blades": "3.0.0-alpha.3",
    "@prettier/plugin-xml": "^3.1.1",
    "@typescript-eslint/parser": "^5.50.0",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^8.9.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-n": "^16.0.1",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-unused-imports": "^3.0.0",
    "husky": "^8.0.3",
    "prettier": "^3.0.0",
    "prettier-plugin-sh": "^0.13.1",
    "tailwindcss": "4.3.3"
  },
  "license": "MIT"
}
