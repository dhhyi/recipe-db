package components

type OpenGraphMetadata struct {
	Title, Type, Image, URL, Description string
}

templ Layout(title string, metadata OpenGraphMetadata) {
	<!DOCTYPE html>
	<html lang="de">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			if metadata.Type != "" {
				<meta property="og:title" content={ metadata.Title }/>
				<meta property="og:type" content={ metadata.Type }/>
				<meta property="og:image" content={ metadata.Image }/>
				<meta property="og:url" content={ metadata.URL }/>
				<meta property="og:description" content={ metadata.Description }/>
			}
			<link rel="stylesheet" href="/design/styles.css"/>
			<script type="module" src="/design/components.js"></script>
			<script src="/design/htmx.min.js"></script>
			<script>
				document.addEventListener("htmx:beforeSwap", (event) => {
					if (event.detail.xhr?.getResponseHeader("X-Browse-Full-Page-Error") !== "true") return;
					event.detail.shouldSwap = true;
					event.detail.isError = false;
					event.detail.target = document.querySelector("main");
				});
			</script>
		</head>
		<body class="container">
			<header-component hx-get="/identity" hx-trigger="load" hx-swap="outerHTML"></header-component>
			<main>
				{ children... }
			</main>
			<footer-component></footer-component>
		</body>
	</html>
}
