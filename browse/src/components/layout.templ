package components

import "frontend/page_metadata"

templ Layout() {
	{{ metadata := pagemetadata.FromContext(ctx) }}
	<!DOCTYPE html>
	<html lang="de">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ metadata.DocumentTitle }</title>
			<link rel="manifest" href="/pwa/manifest.webmanifest"/>
			<link rel="apple-touch-icon" href="/pwa/icons/apple-touch-icon.png"/>
			<meta name="theme-color" content="#014463"/>
			<link rel="icon" type="image/png" sizes="192x192" href="/pwa/icons/chef-hat-192.png"/>
			if metadata.OpenGraphType != "" {
				<meta property="og:title" content={ metadata.OpenGraphTitle }/>
				<meta property="og:type" content={ metadata.OpenGraphType }/>
				<meta property="og:image" content={ metadata.OpenGraphImage }/>
				<meta property="og:url" content={ metadata.OpenGraphURL }/>
				<meta property="og:description" content={ metadata.Description }/>
				<meta name="description" content={ metadata.Description }/>
			}
			<link rel="stylesheet" href="/design/styles.css"/>
			<script type="module" src="/design/components.js"></script>
			<script src="/design/htmx.min.js"></script>
			<script>
				document.addEventListener("htmx:beforeSwap", (event) => {
					if (event.detail.xhr?.getResponseHeader("X-Browse-Full-Page-Error") !== "true") return;
					event.detail.shouldSwap = true;
					event.detail.isError = false;
					event.detail.target = document.querySelector("main");
				});
			</script>
		</head>
		<body class="container flex flex-col min-h-dvh [&>main]:grow">
			<header-component hx-get="/identity" hx-trigger="load" hx-swap="outerHTML"></header-component>
			<main>
				{ children... }
			</main>
			<footer-component></footer-component>
		</body>
	</html>
}
