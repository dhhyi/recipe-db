package components

import gql "frontend/src/generated"

templ SimilarRecipesPlaceholder(id string) {
		<div id="similar-recipes" hx-get={ "/recipe/" + id + "/similar" } hx-trigger="intersect once" hx-target="this" hx-swap="outerHTML" hx-sync="this:drop" hx-push-url="false" hx-replace-url="false" hx-history="false" hx-on::send-error="htmx.trigger(this, 'similar-error')" hx-on::response-error="htmx.trigger(this, 'similar-error')" hx-on::timeout="htmx.trigger(this, 'similar-error')" hx-on:similar-error="this.querySelector('[data-similar-error]').hidden = false; this.querySelector('[data-similar-spinner]').hidden = true; this.querySelector('[data-similar-spinner]').removeAttribute('aria-busy'); this.querySelector('button').hidden = false">
			<div data-similar-spinner aria-busy="true" aria-label="Ähnliche Rezepte werden geladen"></div>
			<p data-similar-error hidden role="alert" class="feedback error">Ähnliche Rezepte konnten nicht geladen werden.</p>
			<button type="button" class="outline" hidden hx-get={ "/recipe/" + id + "/similar" } hx-target="#similar-recipes" hx-swap="outerHTML" hx-sync="#similar-recipes:drop" hx-disabled-elt="this" hx-on::before-request="this.setAttribute('aria-busy', 'true')" hx-on::after-request="this.removeAttribute('aria-busy')">Erneut versuchen</button>
	</div>
}

templ SimilarRecipes(id string, recipes []gql.RecipeStub, remaining []string, failed bool) {
	if len(recipes) > 0 || failed {
		<section id="similar-recipes" hx-history="false">
			<hr/>
			<h2>Ähnliche Rezepte</h2>
			if failed {
				if len(remaining) > 0 {
					<div class="grid! grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2 md:gap-4">
						@SimilarRecipesBatch(id, nil, remaining, true)
					</div>
				} else {
					<p role="alert" class="feedback error">Ähnliche Rezepte konnten nicht geladen werden.</p>
					<button type="button" class="outline" hx-get={ "/recipe/" + id + "/similar" } hx-target="#similar-recipes" hx-swap="outerHTML" hx-sync="#similar-recipes:drop" hx-disabled-elt="this" hx-push-url="false" hx-replace-url="false" hx-on::before-request="this.setAttribute('aria-busy', 'true')" hx-on::after-request="this.removeAttribute('aria-busy')">Erneut versuchen</button>
				}
			} else {
				<div class="grid! grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2 md:gap-4">
					@SimilarRecipesBatch(id, recipes, remaining, false)
				</div>
			}
		</section>
	} else {
		<div id="similar-recipes" hidden></div>
	}
}

templ SimilarRecipesBatch(id string, recipes []gql.RecipeStub, remaining []string, failed bool) {
	for _, recipe := range recipes {
		@recipeTile(recipe, true)
	}
	if len(remaining) > 0 {
		<form id="similar-recipes-more" method="post" action={ "/recipe/" + id + "/similar/more" } hx-post={ "/recipe/" + id + "/similar/more" } hx-target="this" hx-swap="outerHTML" hx-sync="this:drop" hx-disabled-elt="find button" hx-push-url="false" hx-replace-url="false" hx-history="false" hx-on::before-request="this.querySelector('button[type=submit]')?.setAttribute('aria-busy', 'true')" hx-on::after-request="this.querySelector('button[type=submit]')?.removeAttribute('aria-busy')" hx-on::send-error="htmx.trigger(this, 'similar-error')" hx-on::response-error="htmx.trigger(this, 'similar-error')" hx-on::timeout="htmx.trigger(this, 'similar-error')" hx-on:similar-error="this.querySelector('[data-similar-error]').hidden = false; this.querySelector('button').textContent = 'Erneut versuchen'; this.querySelector('[data-similar-error]').classList.add('feedback', 'error')" class="col-span-full">
			for _, candidate := range remaining {
				<input type="hidden" name="remainingId" value={ candidate }/>
			}
			<p data-similar-error hidden?={ !failed } role="alert" class="feedback error">Ähnliche Rezepte konnten nicht geladen werden.</p>
			if failed {
				<button type="submit" class="outline">Erneut versuchen</button>
			} else {
				<button type="submit" class="outline">Mehr anzeigen</button>
			}
		</form>
	}
}
