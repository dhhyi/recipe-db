package components

import gql "frontend/src/generated"

templ BrowseControls(resp *gql.BrowseControlsResponse) {
	<div id="browse-controls" class="sticky bottom-0 z-10 flex justify-end pb-3 pointer-events-none">
		if resp.MyCapabilities.CanManageRecipes && resp.RecipeEditOnline {
			<a href="/edit/new" role="button" data-add-recipe class="outline pointer-events-auto mr-2">Rezept hinzufügen</a>
		}
	</div>
}

templ BrowseIdentity(resp *gql.BrowseIdentityResponse, googleOAuthEnabled bool) {
	if googleOAuthEnabled {
		<header-component auth-role={ resp.MyCapabilities.Role } auth-enabled></header-component>
	} else {
		<header-component auth-role={ resp.MyCapabilities.Role }></header-component>
	}
}

templ RecipeRatingControls(id string, resp *gql.RecipeRatingResponse) {
	if resp.Recipe != nil && resp.Recipe.Rating != nil {
		@RecipeRatingWidget(id, &resp.Recipe.Rating.Rating, resp.MyCapabilities.CanRate, resp.Recipe.Rating.MyRating, false)
	} else {
		@RecipeRatingUnavailable()
	}
}

templ RecipeRatingWidget(id string, rating *gql.Rating, canRate bool, myRating *int, saved bool) {
	<div id={ "recipe-rating-" + id } data-rating-saved?={ saved }>
		@Rating(rating, canRate, nil, myRating)
	</div>
}

templ RecipeRatingUnavailable() {
	<div id="recipe-rating" role="status">
		<p class="feedback error">Bewertung derzeit nicht verfügbar.</p>
	</div>
}

templ BrowseIdentityUnavailable(showLogin bool) {
	if showLogin {
		<header-component auth-role="anonymous" auth-enabled></header-component>
	} else {
		<header-component></header-component>
	}
}

templ RatingDeniedPage(status int) {
	if status == 401 {
		<p role="alert" class="feedback error">Zum Bewerten ist eine Anmeldung erforderlich oder die Anmeldung ist abgelaufen.</p>
		<a href="/">Zurück zur Übersicht</a>
	} else {
		<p role="alert" class="feedback error">Dein Konto darf keine Bewertungen abgeben.</p>
		<a href="/">Zurück zur Übersicht</a>
	}
}
