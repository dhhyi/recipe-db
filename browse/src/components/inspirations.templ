package components

import "frontend/src/generated"

templ inspiration(in gql.InspirationsLink) {
	if in.Extracted != nil && in.Extracted.Canonical != nil {
		<a
			class="flex gap-2 items-center"
			href={ *in.Extracted.Canonical }
			if in.Extracted.Description != nil {
				title={ *in.Extracted.Description }
			}
		>
			if in.Extracted.InlinedFavicon != nil {
				<img
					height
					class="h-5"
					src={ *in.Extracted.InlinedFavicon }
				/>
			}
			if in.Extracted.Title != nil {
				{ *in.Extracted.Title }
			}
		</a>
	} else if len(in.Url) > 0 {
		<a href={ in.Url }>
			{ in.Url }
		</a>
	}
}

templ InspirationsLazy(in *gql.RecipeInspirationsResponse) {
	if in.InspirationsOnline && in.Recipe != nil && len(in.Recipe.Inspirations) > 0 {
		<section>
			<header>
				<h2>Inspirationen</h2>
			</header>
			@inspirationsList(in.Recipe.Inspirations)
		</section>
	}
}

templ inspirationsList(in []gql.InspirationsLink) {
	<ul class="markerless">
		for _, insp := range in {
			<li>
				@inspiration(insp)
			</li>
		}
	</ul>
}

templ InspirationsStub(recipeId string) {
	<div
		id="recipe-inspirations"
		hx-get={ "/recipe/" + recipeId + "/inspirations" }
		hx-trigger="intersect"
		hx-target="this"
		hx-swap="outerHTML"
		hx-on::send-error="htmx.trigger(this, 'inspirations-error')"
		hx-on::response-error="htmx.trigger(this, 'inspirations-error')"
		hx-on::timeout="htmx.trigger(this, 'inspirations-error')"
		hx-on:inspirations-error="this.querySelector('[data-inspirations-spinner]').hidden = true; this.querySelector('[data-inspirations-spinner]').removeAttribute('aria-busy'); this.querySelector('[data-inspirations-error]').hidden = false; this.querySelector('button').hidden = false"
	>
		<div data-inspirations-spinner aria-busy="true" aria-label="Inspirationen werden geladen"></div>
		<p data-inspirations-error hidden role="alert" class="feedback error">Inspirationen konnten nicht geladen werden.</p>
		<button
			type="button"
			class="outline"
			hidden
			hx-get={ "/recipe/" + recipeId + "/inspirations" }
			hx-target="#recipe-inspirations"
			hx-swap="outerHTML"
			hx-disabled-elt="this"
			hx-on::before-request="this.setAttribute('aria-busy', 'true')"
			hx-on::after-request="this.removeAttribute('aria-busy')"
		>Erneut versuchen</button>
	</div>
}
