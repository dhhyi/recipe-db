package components

import gql "frontend/src/generated"
import "encoding/json"
import "fmt"
import "strconv"

type BrowseState struct {
	Query, Sort, Kind, Message  string
	Page, PerPage, Found        int
	EditorOnline, RatingsOnline bool
	Recipes                     []gql.RecipeStub
	NextURL                     string
	SeenIDs                     []string
}

func (state BrowseState) PaginationValues() string {
	if len(state.SeenIDs) == 0 {
		return `{"seen":[]}`
	}
	values, _ := json.Marshal(map[string][]string{"seen": state.SeenIDs})
	return string(values)
}

func (state BrowseState) Title() string {
	if state.Kind == "error" {
		return "Rezepte konnten nicht geladen werden | RezeptDB"
	}
	if state.Kind == "search" && state.Query != "" {
		return fmt.Sprintf("%d Rezepte für '%s' | RezeptDB", state.Found, state.Query)
	}
	return "Alle Rezepte | RezeptDB"
}

type browseSortOption struct {
	Token, Label string
}

var browseSortOptions = []browseSortOption{
	{"relevance", "Relevanz"},
	{"rating", "Beste Bewertung"},
	{"rating-count", "Meiste Bewertungen"},
	{"name-asc", "Name A-Z"},
	{"name-desc", "Name Z-A"},
	{"newest", "Neueste zuerst"},
	{"updated", "Zuletzt bearbeitet"},
}

func automaticSortLabel(query string) string {
	if query == "" {
		return "Automatisch: Neueste zuerst"
	}
	return "Automatisch: Relevanz"
}

templ recipeTile(item gql.RecipeStub, ratingsOnline bool) {
	<a href={ "/recipe/" + item.Id } aria-label={ "Rezept " + item.Name } hx-boost="true" data-recipe-id={ item.Id }>
		<recipe-tile-component itemscope itemtype="https://schema.org/Recipe">
			<h2 slot="title" class="font-bold" itemprop="name" title={ item.Name }>{ item.Name }</h2>
			if item.Image != nil {
				<img slot="image" src={ item.Image.ThumbUrl } alt={ item.Name } itemprop="image"/>
			}
			if ratingsOnline && item.Rating != nil {
				{{ slot := "rating" }}
				@Rating(item.Rating, false, &slot)
			}
		</recipe-tile-component>
	</a>
}

// Restore live controls and loaded depth from the server instead of a snapshot
// whose form value attributes may predate the last search.
templ Browse(state BrowseState) {
	<div id="browse-content" data-browse-search hx-history="false" hx-on::send-error="htmx.trigger(this, 'browse-error', event.detail)" hx-on::response-error="htmx.trigger(this, 'browse-error', event.detail)" hx-on:browse-error="const target = event.detail.target, status = this.querySelector('#browse-metadata'); if (target.id === 'browse-results') { target.querySelector('[data-recipe-list]').replaceChildren(); status.dataset.kind = 'error'; status.textContent = 'Rezepte konnten nicht geladen werden.'; document.title = 'Rezepte konnten nicht geladen werden | RezeptDB'; } else if (target.id === 'browse-pagination') { status.textContent = 'Weitere Rezepte konnten nicht geladen werden.'; target.querySelector('[data-load-more]').textContent = 'Erneut versuchen'; }">
		<h1>Alle Rezepte</h1>
		<form id="browse-form" action="/" method="get" hx-get="/" hx-target="#browse-results" hx-swap="outerHTML show:none" hx-sync="this:replace" hx-trigger="input[!event.isComposing] delay:300ms, compositionend delay:300ms, change[!event.target.closest('form').dataset.composing] from:#browse-sort, submit[!event.target.dataset.composing]" hx-on:input="htmx.trigger(this, 'htmx:abort')" hx-on:compositionstart="this.dataset.composing = 'true'; htmx.trigger(this, 'htmx:abort')" hx-on:compositionend="delete this.dataset.composing" hx-on::config-request="if (this.dataset.composing) event.preventDefault()" class="my-3 grid! grid-cols-1 md:grid-cols-2 md:gap-3">
			<fieldset role="search">
				<input id="browse-query" type="search" name="q" placeholder="Rezepte suchen" value={ state.Query } disabled?={ state.Kind == "fallback" }/>
				<button type="submit" aria-label="Suchen" disabled?={ state.Kind == "fallback" }>
					<svg aria-hidden="true" focusable="false" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="11" cy="11" r="8"></circle>
						<path d="m21 21-4.35-4.35"></path>
					</svg>
				</button>
			</fieldset>
			<select class="md:max-w-[350px] md:ml-auto! rounded-full!" id="browse-sort" name="sort" aria-label="Sortieren nach" disabled?={ state.Kind == "fallback" }>
				<option id="browse-automatic" value="" hidden selected?={ state.Sort == "" }>{ automaticSortLabel(state.Query) }</option>
				for _, option := range browseSortOptions {
					<option value={ option.Token } selected?={ state.Sort == option.Token }>{ option.Label }</option>
				}
			</select>
		</form>
		@BrowseResults(state, true)
	</div>
}

templ browseStatus(state BrowseState, attributes templ.Attributes) {
	<p { attributes... } id="browse-metadata" data-kind={ state.Kind } data-page={ strconv.Itoa(state.Page) } data-per-page={ strconv.Itoa(state.PerPage) } data-found={ strconv.Itoa(state.Found) } data-query={ state.Query } data-sort={ state.Sort } data-browse-status role="status" aria-live="polite" aria-atomic="true" class="text-center">
		if state.Message != "" {
			{ state.Message }
		} else if state.Found == 0 {
			Keine Rezepte gefunden.
		} else {
			{ strconv.Itoa(state.Found) } Rezepte gefunden.
		}
	</p>
}

templ BrowseResults(state BrowseState, includeStatus bool) {
	<section id="browse-results">
		if includeStatus {
			@browseStatus(state, nil)
		}
		<div data-browse-grid class="grid! grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-2 md:gap-4 mx-auto max-w-[350px] sm:max-w-none">
			<div data-recipe-list class="contents">
				for _, recipe := range state.Recipes {
					@recipeTile(recipe, state.RatingsOnline)
				}
				@browsePagination(state)
			</div>
			if state.EditorOnline {
				<a href="/edit/new" data-add-recipe class="contents" aria-label="Neues Rezept hinzufügen">
					<article class="flex items-center justify-center" style="font-size: 3rem; text-decoration: none;">+</article>
				</a>
			}
		</div>
	</section>
}

templ browsePagination(state BrowseState) {
	if state.NextURL != "" {
		<div id="browse-pagination" class="contents">
			<nav aria-label="Weitere Rezepte" class="justify-center col-span-full order-1">
				<a href={ templ.SafeURL(state.NextURL) } hx-get={ state.NextURL } hx-vals={ state.PaginationValues() } hx-trigger="intersect once, click" hx-target="#browse-pagination" hx-swap="outerHTML show:none" hx-sync="#browse-form:abort" data-load-more data-sentinel>Mehr laden</a>
			</nav>
		</div>
	}
}

templ BrowsePage(state BrowseState) {
	<title>{ state.Title() }</title>
	@browseStatus(state, templ.Attributes{"hx-swap-oob": "outerHTML"})
	for _, recipe := range state.Recipes {
		@recipeTile(recipe, state.RatingsOnline)
	}
	@browsePagination(state)
}

templ BrowseFragment(state BrowseState) {
	<title>{ state.Title() }</title>
	<template>
		<option id="browse-automatic" hx-swap-oob="outerHTML" value="" hidden selected?={ state.Sort == "" }>{ automaticSortLabel(state.Query) }</option>
	</template>
	@BrowseResults(state, true)
}

templ BrowseFallbackFragment(state BrowseState) {
	<title>{ state.Title() }</title>
	@Browse(state)
}

templ BrowsePageError(state BrowseState, retryURL string) {
	<div id="browse-pagination" class="contents">
		<nav aria-label="Weitere Rezepte" class="justify-center col-span-full order-1">
			<p role="status" aria-live="polite">Weitere Rezepte konnten nicht geladen werden.</p>
			<a href={ templ.SafeURL(retryURL) } hx-get={ retryURL } hx-vals={ state.PaginationValues() } hx-target="#browse-pagination" hx-swap="outerHTML show:none" hx-sync="#browse-form:abort" data-load-more>Erneut versuchen</a>
		</nav>
	</div>
}
