package components

import gql "frontend/src/generated"
import "encoding/json"
import "fmt"
import "strconv"

type BrowseState struct {
	Query, SortBy, FilterBy, TagName, Kind, Message string
	Page, PerPage, Found                         int
	FilterByPresent                              bool
	RatingsOnline                                bool
	Recipes                                      []gql.RecipeStub
	NextURL                                      string
	SeenIDs                                      []string
}

func (state BrowseState) PaginationValues() string {
	if len(state.SeenIDs) == 0 {
		return `{"seen":[]}`
	}
	values, _ := json.Marshal(map[string][]string{"seen": state.SeenIDs})
	return string(values)
}

func (state BrowseState) Title() string {
	if state.Kind == "error" {
		if state.Message == "Ungültige Suchparameter." {
			return "Ungültige Suchparameter | RezeptDB"
		}
		if state.FilterBy != "" {
			return "Suchfilter konnten nicht angewendet werden | RezeptDB"
		}
		return "Rezepte konnten nicht geladen werden | RezeptDB"
	}
	return state.Heading() + " | RezeptDB"
}

func (state BrowseState) RecipeCount() string {
	if state.Found == 1 {
		return "1 Rezept"
	}
	return fmt.Sprintf("%d Rezepte", state.Found)
}

func (state BrowseState) Heading() string {
	if state.Kind == "search" && state.TagName != "" && state.Query == "" {
		return "Suchergebnisse für Tag „" + state.TagName + "“"
	}
	if state.Kind == "search" && state.Query != "" {
		return fmt.Sprintf("%s für '%s'", state.RecipeCount(), state.Query)
	}
	if state.Kind == "search" && state.FilterBy != "" {
		return "Gefilterte Suchergebnisse"
	}
	return "Alle Rezepte"
}

templ browseHeading(state BrowseState, attributes templ.Attributes) {
	<h1 id="browse-heading" { attributes... }>{ state.Heading() }</h1>
}

type browseSortOption struct {
	Value, Label string
}

var browseSortOptions = []browseSortOption{
	{"_text_match:desc,created_at:desc,recipe_id_sort:asc", "Relevanz"},
	{"rating_average:desc,rating_count:desc,recipe_id_sort:asc", "Beste Bewertung"},
	{"rating_count:desc,rating_average:desc,recipe_id_sort:asc", "Meiste Bewertungen"},
	{"name_sort:asc,recipe_id_sort:asc", "Name A-Z"},
	{"name_sort:desc,recipe_id_sort:asc", "Name Z-A"},
	{"created_at:desc,recipe_id_sort:asc", "Neueste zuerst"},
	{"updated_at:desc,recipe_id_sort:asc", "Zuletzt bearbeitet"},
}

func isPredefinedBrowseSort(value string) bool {
	for _, option := range browseSortOptions {
		if value == option.Value {
			return true
		}
	}
	return false
}

templ recipeTile(item gql.RecipeStub, ratingsOnline bool) {
	<recipe-tile-component itemscope itemtype="https://schema.org/Recipe" data-recipe-id={ item.Id } style={ fmt.Sprintf("--recipe-tile-transition-name: recipe-tile-%x", item.Id) }>
		<a href={ "/recipe/" + item.Id } slot="title" aria-label={ recipeAccessibleLabel(item) } hx-boost="true" hx-swap="innerHTML transition:true">
			<h2 class="recipe-tile-title" itemprop="name" title={ item.Name }>{ item.Name }</h2>
		</a>
		if item.Image != nil {
			<a href={ "/recipe/" + item.Id } slot="image" aria-label={ "Bild von Rezept " + item.Name } hx-boost="true" hx-swap="innerHTML transition:true">
				<img src={ item.Image.ThumbUrl } alt={ item.Name } itemprop="image" style={ recipeImageTransitionStyle(item.Id) }/>
			</a>
		}
		if ratingsOnline && item.Rating != nil {
			<a href={ "/recipe/" + item.Id } slot="rating" class="block" style={ recipeRatingTransitionStyle(item.Id) } aria-label={ "Bewertung von Rezept " + item.Name } hx-boost="true" hx-swap="innerHTML transition:true">
				@Rating(item.Rating, false, nil, nil)
			</a>
		}
		@recipeCardTags(item.Id, item.Tags)
	</recipe-tile-component>
}

// Restore live controls and loaded depth from the server instead of a snapshot
// whose form value attributes may predate the last search.
templ Browse(state BrowseState) {
	<div id="browse-content" data-browse-search hx-history="false" hx-on::send-error="htmx.trigger(this, 'browse-error', event.detail)" hx-on::response-error="htmx.trigger(this, 'browse-error', event.detail)" hx-on::timeout="htmx.trigger(this, 'browse-error', event.detail)" hx-on:browse-error="const target = event.detail.target, status = this.querySelector('#browse-metadata'); if (target.id === 'browse-results') { target.querySelector('[data-recipe-list]').replaceChildren(); status.dataset.kind = 'error'; status.className = 'feedback error text-center'; status.textContent = 'Rezepte konnten nicht geladen werden.'; document.title = 'Rezepte konnten nicht geladen werden | RezeptDB'; } else if (target.id === 'browse-pagination') { const message = target.querySelector('[data-pagination-error]'), retry = target.querySelector('[data-load-more]'), spinner = target.querySelector('[data-pagination-spinner]'); if (message) message.hidden = false; if (retry) retry.hidden = false; if (spinner) { spinner.hidden = true; spinner.removeAttribute('aria-busy'); } }">
		@browseHeading(state, nil)
		// HTMX starts the transition after this event; type it before snapshot capture.
		<form id="browse-form" action="/" method="get" hx-get="/" hx-target="#browse-results" hx-swap="outerHTML show:none transition:true" hx-sync="this:replace" hx-trigger="input[!event.isComposing] delay:300ms, compositionend delay:300ms, change[!event.target.closest('form').dataset.composing] from:#browse-sort, submit[!event.target.dataset.composing]" hx-on:input="htmx.trigger(this, 'htmx:abort')" hx-on:compositionstart="this.dataset.composing = 'true'; htmx.trigger(this, 'htmx:abort')" hx-on:compositionend="delete this.dataset.composing" hx-on::config-request="if (this.dataset.composing) event.preventDefault()" hx-on::before-transition="if (event.detail.target.id !== 'browse-results' || !('activeViewTransition' in document) || !CSS.supports('selector(:active-view-transition-type(browse-results))')) { event.preventDefault(); } else { queueMicrotask(() => document.activeViewTransition?.types.add('browse-results')); }" class="my-3 grid grid-cols-1 md:grid-cols-2 md:gap-3">
			<fieldset role="search">
				<input id="browse-query" type="search" name="q" placeholder="Rezepte suchen" aria-label="Rezepte suchen" value={ state.Query } hx-on:input="this.form.elements.namedItem('filter_by')?.remove()" disabled?={ state.Kind == "fallback" }/>
				<button type="submit" aria-label="Suchen" disabled?={ state.Kind == "fallback" }>
					<svg aria-hidden="true" focusable="false" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="11" cy="11" r="8"></circle>
						<path d="m21 21-4.35-4.35"></path>
					</svg>
				</button>
			</fieldset>
			<select class="md:max-w-[350px] md:ml-auto rounded-full" id="browse-sort" name="sort_by" aria-label="Sortieren nach" disabled?={ state.Kind == "fallback" }>
				<option id="browse-automatic" value="" selected?={ state.SortBy == "" }>Automatisch</option>
				for _, option := range browseSortOptions {
					<option value={ option.Value } selected?={ state.SortBy == option.Value }>{ option.Label }</option>
				}
				if state.SortBy != "" && !isPredefinedBrowseSort(state.SortBy) {
					<option value={ state.SortBy } selected>Benutzerdefinierte Sortierung</option>
				}
			</select>
			if state.FilterByPresent {
				<input type="hidden" name="filter_by" value={ state.FilterBy }/>
			}
		</form>
		@BrowseResults(state, true)
		<div hx-get="/controls" hx-trigger="load" hx-swap="outerHTML"></div>
	</div>
}

templ browseStatus(state BrowseState, attributes templ.Attributes) {
	<p { attributes... } id="browse-metadata" data-kind={ state.Kind } data-page={ strconv.Itoa(state.Page) } data-per-page={ strconv.Itoa(state.PerPage) } data-found={ strconv.Itoa(state.Found) } data-query={ state.Query } data-sort-by={ state.SortBy } data-browse-status role="status" aria-live="polite" aria-atomic="true" class="text-center">
		if state.Message != "" {
			{ state.Message }
		} else if state.Found == 0 {
			Keine Rezepte gefunden.
		} else {
			{ state.RecipeCount() } gefunden.
		}
	</p>
}

templ BrowseResults(state BrowseState, includeStatus bool) {
	<section id="browse-results">
		if includeStatus {
			@browseStatus(state, nil)
		}
		<div data-browse-grid class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-2 mx-auto max-w-[350px] sm:max-w-none">
			<div data-recipe-list class="contents">
				for _, recipe := range state.Recipes {
					@recipeTile(recipe, state.RatingsOnline)
				}
				@browsePagination(state)
			</div>
		</div>
	</section>
}

templ browsePagination(state BrowseState) {
	if state.NextURL != "" {
		<div id="browse-pagination" class="contents" hx-get={ templ.SafeURL(state.NextURL) } hx-vals={ state.PaginationValues() } hx-trigger="intersect once" hx-target="this" hx-swap="outerHTML show:none" hx-sync="#browse-form:abort">
			<nav aria-label="Weitere Rezepte" class="justify-center col-span-full order-1">
				<div data-pagination-spinner aria-busy="true" aria-label="Weitere Rezepte werden geladen"></div>
				<p data-pagination-error hidden role="alert" class="feedback error">Weitere Rezepte konnten nicht geladen werden.</p>
				<button
					type="button"
					class="outline"
					data-load-more
					hidden
					hx-get={ templ.SafeURL(state.NextURL) }
					hx-vals={ state.PaginationValues() }
					hx-target="#browse-pagination"
					hx-swap="outerHTML show:none"
					hx-sync="#browse-form:abort"
					hx-disabled-elt="this"
					hx-on::before-request="this.setAttribute('aria-busy', 'true')"
					hx-on::after-request="this.removeAttribute('aria-busy')"
				>Erneut versuchen</button>
			</nav>
		</div>
	}
}

templ BrowsePage(state BrowseState) {
	<title>{ state.Title() }</title>
	@browseHeading(state, templ.Attributes{"hx-swap-oob": "outerHTML"})
	@browseStatus(state, templ.Attributes{"hx-swap-oob": "outerHTML"})
	for _, recipe := range state.Recipes {
		@recipeTile(recipe, state.RatingsOnline)
	}
	@browsePagination(state)
}

templ BrowseFragment(state BrowseState) {
	<title>{ state.Title() }</title>
	@browseHeading(state, templ.Attributes{"hx-swap-oob": "outerHTML"})
	@BrowseResults(state, true)
}

templ BrowseFallbackFragment(state BrowseState) {
	<title>{ state.Title() }</title>
	@Browse(state)
}

templ BrowsePageError(state BrowseState, retryURL string) {
	<div id="browse-pagination" class="contents">
		<nav aria-label="Weitere Rezepte" class="justify-center col-span-full order-1">
			<p role="alert" aria-live="polite" class="feedback error">Weitere Rezepte konnten nicht geladen werden.</p>
			<button type="button" class="outline" hx-get={ templ.SafeURL(retryURL) } hx-vals={ state.PaginationValues() } hx-target="#browse-pagination" hx-swap="outerHTML show:none" hx-sync="#browse-form:abort" hx-disabled-elt="this" hx-on::before-request="this.setAttribute('aria-busy', 'true')" hx-on::after-request="this.removeAttribute('aria-busy')" data-load-more>Erneut versuchen</button>
		</nav>
	</div>
}
