package components

import "frontend/src/generated"
import "frontend/src/util"
import "fmt"
import "net/url"

func recipeImageTransitionStyle(id string) string {
	return fmt.Sprintf("view-transition-name: recipe-image-%x", id)
}

func recipeImageLoading(index int) string {
	if index == 0 {
		return "eager"
	}
	return "lazy"
}

templ editFields(id string, recipeEdit bool, images bool, imageEdit bool) {
	if recipeEdit || (images && imageEdit) {
		<details class="dropdown sm:ml-auto">
			<summary role="button" class="outline whitespace-nowrap sm:w-max">Bearbeiten</summary>
			<ul dir="rtl" class="text-left sm:text-right">
				if recipeEdit {
					<li><a href={ "/edit/" + id }>Rezept bearbeiten</a></li>
				}
				if images && imageEdit {
					<li><a href={ "/images-edit/" + id }>Bilder bearbeiten</a></li>
				}
			</ul>
		</details>
	}
}

templ RecipeControls(id string, resp *gql.RecipeControlsResponse) {
	@editFields(
		id,
		!resp.Maintenance && resp.MyCapabilities.CanManageRecipes && resp.RecipeEditOnline,
		resp.ImagesOnline,
		!resp.Maintenance && resp.MyCapabilities.CanManageImages && resp.ImageEditOnline,
	)
}

templ image(recipe *gql.RecipeDetail, imageURL string, imageID string) {
	<recipe-image-carousel
		class="recipe-image recipe-image-frame"
		style={ recipeImageTransitionStyle(recipe.Id) }
	>
		<img
			class="recipe-image-content"
			data-image-id={ imageID }
			src={ imageURL }
			alt={ recipe.Name }
			itemprop="image"
			loading="eager"
		/>
	</recipe-image-carousel>
}

templ imageCarousel(recipe *gql.RecipeDetail) {
	<recipe-image-carousel
		class="recipe-image recipe-image-frame"
		style={ recipeImageTransitionStyle(recipe.Id) }
	>
		<div class="swiper" role="region" aria-label="Rezeptbilder" aria-roledescription="Karussell">
			<div class="swiper-wrapper">
				for index, recipeImage := range recipe.Images {
					<div class="swiper-slide">
						<img
							class="recipe-image-content"
							data-image-id={ recipeImage.Id }
							src={ recipeImage.Url }
							alt={ recipe.Name }
							itemprop="image"
							decoding="async"
							loading={ recipeImageLoading(index) }
						/>
					</div>
				}
			</div>
			<button class="swiper-button-prev" type="button" aria-label="Vorheriges Bild" data-carousel-prev hidden></button>
			<button class="swiper-button-next" type="button" aria-label="Nächstes Bild" data-carousel-next hidden></button>
			<div class="swiper-pagination" data-carousel-pagination hidden></div>
		</div>
	</recipe-image-carousel>
}

templ ingredients(recipe *gql.RecipeDetail, publicURL string) {
	<section>
		<header>
			<h2>Zutaten</h2>
		</header>
		<table class="mb-0">
			<thead>
				<tr>
					<th>Anzahl</th>
					<th>Zutat</th>
				</tr>
			</thead>
			<tbody>
				for _, ingredient := range recipe.Ingredients {
					<tr itemprop="recipeIngredient">
						<td>
							if ingredient.Amount != nil {
								{ *ingredient.Amount }
							}
							if ingredient.Unit != nil {
								{ *ingredient.Unit }
							}
							if ingredient.Optional != nil && *ingredient.Optional {
								<span>(optional) </span>
							}
						</td>
						<td>
							{ ingredient.Name }
						</td>
					</tr>
				}
			</tbody>
			<tfoot>
				<tr>
					<td colspan="2" class="px-0!">
						<div class="flex justify-end pt-4">
							<a href={ templ.SafeURL("https://api.getbring.com/rest/bringrecipes/deeplink?url=" + url.QueryEscape(publicURL) + "&source=web&baseQuantity=4&requestedQuantity=4") } target="_blank" rel="noopener">Auf die Einkaufsliste</a>
						</div>
					</td>
				</tr>
			</tfoot>
		</table>
	</section>
}

templ method(recipe *gql.RecipeDetail) {
	if recipe.Method != nil && len(*recipe.Method) > 0 {
		<section>
			<header>
				<h2>Zubereitung</h2>
			</header>
			<div itemprop="recipeInstructions">
				@templ.Raw(util.ToMarkDown(*recipe.Method))
			</div>
		</section>
	}
}

templ Detail(resp *gql.RecipeByIdResponse, publicURL string) {
	{{ recipe := resp.Recipe }}
	<div itemscope itemtype="https://schema.org/Recipe" class="contents" hx-history="false">
		<div class="flex flex-col sm:flex-row pt-1">
			<hgroup>
				<h1 itemprop="name">{ recipe.Name }</h1>
				if recipe.Rating != nil {
					// Keep the snapshot outside the widget replaced by its live refresh.
					<div class="recipe-rating w-fit" style={ recipeRatingTransitionStyle(recipe.Id) }>
						<div id={ "recipe-rating-" + recipe.Id } hx-get={ "/recipe/" + recipe.Id + "/rating" } hx-trigger="load" hx-swap="outerHTML">
							@Rating(recipe.Rating, false, nil, nil)
						</div>
					</div>
				}
			</hgroup>
			<div class="contents" hx-get={ "/recipe/" + recipe.Id + "/controls" } hx-trigger="load" hx-swap="outerHTML"></div>
		</div>
		<section class="grid grid-cols-1 gap-3 md:grid-cols-2">
			if len(recipe.Images) > 1 {
				<div class="flex flex-col gap-2">
					@imageCarousel(recipe)
					@recipeDetailTags(recipe.Id, recipe.Tags)
				</div>
			} else if len(recipe.Images) == 1 {
				<div class="flex flex-col gap-2">
					@image(recipe, recipe.Images[0].Url, recipe.Images[0].Id)
					@recipeDetailTags(recipe.Id, recipe.Tags)
				</div>
			} else if recipe.Images == nil && recipe.Image != nil {
				<div class="flex flex-col gap-2">
					@image(recipe, recipe.Image.Url, "")
					@recipeDetailTags(recipe.Id, recipe.Tags)
				</div>
			} else {
				@recipeDetailTags(recipe.Id, recipe.Tags)
			}
			if len(recipe.Ingredients) > 0 {
				@ingredients(recipe, publicURL)
			}
		</section>
		if recipe.Method != nil && len(*recipe.Method) > 0 {
			@method(recipe)
		}
		@InspirationsStub(recipe.Id)
	</div>
	<p>
		<small>
			Zuletzt aktualisiert: { util.RelativeTimeInGerman(recipe.UpdatedAt) }
		</small>
	</p>
	<p>
		<a href="/" data-browse-home hx-boost="true" hx-swap="innerHTML transition:true">Zur Startseite</a>
	</p>
	@SimilarRecipesPlaceholder(recipe.Id)
}
