package components

import "frontend/src/generated"
import "frontend/src/util"

templ editFields(id string, recipeEdit bool, images bool, imageEdit bool) {
	if recipeEdit || (images && imageEdit) {
		<details class="dropdown sm:ml-auto">
			<summary role="button" class="outline">Bearbeiten</summary>
			<ul class="markerless">
				if recipeEdit {
					<li><a href={ "/edit/" + id }>Rezept bearbeiten</a></li>
				}
				if images && imageEdit {
					<li><a href={ "/images-edit/" + id }>Bilder bearbeiten</a></li>
				}
			</ul>
		</details>
	}
}

templ RecipeControls(id string, resp *gql.RecipeControlsResponse) {
	@editFields(
		id,
		resp.MyCapabilities.CanManageRecipes && resp.RecipeEditOnline,
		resp.ImagesOnline,
		resp.MyCapabilities.CanManageImages && resp.ImageEditOnline,
	)
}

templ image(recipe *gql.RecipeDetail) {
	<figure class="contents!">
		<img
			class="recipe-image"
			src={ recipe.Image.Url }
			alt={ recipe.Name }
			itemprop="image"
		/>
	</figure>
}

templ ingredients(recipe *gql.RecipeDetail) {
	<section>
		<header>
			<h2>Zutaten</h2>
		</header>
		<table class="mb-0!">
			<thead>
				<tr>
					<th>Anzahl</th>
					<th>Zutat</th>
				</tr>
			</thead>
			<tbody>
				for _, ingredient := range recipe.Ingredients {
					<tr itemprop="recipeIngredient">
						<td>
							if ingredient.Amount != nil {
								{ *ingredient.Amount }
							}
							if ingredient.Unit != nil {
								{ *ingredient.Unit }
							}
							if ingredient.Optional != nil && *ingredient.Optional {
								<span>(optional) </span>
							}
						</td>
						<td>
							{ ingredient.Name }
						</td>
					</tr>
				}
			</tbody>
		</table>
	</section>
}

templ method(recipe *gql.RecipeDetail) {
	if recipe.Method != nil && len(*recipe.Method) > 0 {
		<section>
			<header>
				<h2>Zubereitung</h2>
			</header>
			<div itemprop="recipeInstructions">
				@templ.Raw(util.ToMarkDown(*recipe.Method))
			</div>
		</section>
	}
}

templ Detail(resp *gql.RecipeByIdResponse) {
	{{ recipe := resp.Recipe }}
	<div itemscope itemtype="https://schema.org/Recipe" class="contents" hx-history="false">
		<div class="flex flex-col sm:flex-row pt-1">
			<hgroup>
				<h1 itemprop="name">{ recipe.Name }</h1>
				if recipe.Rating != nil {
					<div id={ "recipe-rating-" + recipe.Id } hx-get={ "/recipe/" + recipe.Id + "/rating" } hx-trigger="load" hx-swap="outerHTML">
						@Rating(recipe.Rating, false, nil, nil)
					</div>
				}
			</hgroup>
			<div class="contents" hx-get={ "/recipe/" + recipe.Id + "/controls" } hx-trigger="load" hx-swap="outerHTML"></div>
		</div>
		<section class="grid">
			if recipe.Image != nil {
				<div class="flex flex-col gap-2">
				@image(recipe)
				@recipeDetailTags(recipe.Tags)
				</div>
			} else {
				@recipeDetailTags(recipe.Tags)
			}
			if len(recipe.Ingredients) > 0 {
				@ingredients(recipe)
			}
		</section>
		if recipe.Method != nil && len(*recipe.Method) > 0 {
			@method(recipe)
		}
		@InspirationsStub(recipe.Id)
	</div>
	<p>
		<small>
			Zuletzt aktualisiert: { util.RelativeTimeInGerman(recipe.UpdatedAt) }
		</small>
	</p>
	<a href="/" role="button">Zur Startseite</a>
}
