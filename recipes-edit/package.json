{
  "name": "recipes-edit",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "clojure -M -m shadow.cljs.devtools.cli release app",
    "lint": "clojure -M:lint --lint src",
    "watch": "clojure -M -m shadow.cljs.devtools.cli watch app",
    "test": "pnpm test:jvm && pnpm test:cljs",
    "test:jvm": "clojure -M -m recipes-edit.test-runner",
    "test:cljs": "clojure -M -m shadow.cljs.devtools.cli compile test && node target/test.js"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "scheduler": "0.23.2"
  }
}
