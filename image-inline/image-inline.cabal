cabal-version: 2.4
name: image-inline
version: 0.1.0.0
build-type: Simple

executable image-inline
  main-is: Main.hs
  hs-source-dirs: .
  build-depends:
    aeson,
    base >=4 && <5,
    base16-bytestring,
    base64-bytestring,
    bytestring,
    cryptohash-md5,
    directory,
    filepath,
    http-client,
    http-client-tls,
    http-types,
    scotty,
    text
  default-language: Haskell2010
  ghc-options: -Wall -threaded -optl-static -optl-pthread
