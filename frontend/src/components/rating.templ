package components

import "frontend/src/generated"

templ Rating(rating *gql.Rating, ratingPossible bool) {
	<rating-component
		if rating.Average != nil {
			rating={ *rating.Average }
		}
		if rating.Count != nil {
			count={ *rating.Count }
		}
		if ratingPossible {
			hx-post={ "/recipe/" + rating.RecipeId + "/rate" }
			hx-target="this"
			hx-swap="outerHTML"
			hx-trigger="rated"
			hx-vals="js:{rating: event.detail}"
		}
	></rating-component>
}
