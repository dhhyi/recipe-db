{
  "$id": "https://example.com/language.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["category"],
  "allOf": [
    {
      "if": {
        "properties": {
          "category": {
            "enum": ["api", "backend"]
          }
        },
        "required": ["category"]
      },
      "then": {
        "required": ["backupRole"]
      }
    },
    {
      "if": {
        "properties": {
          "backupCompact": {
            "const": true
          }
        },
        "required": ["backupCompact"]
      },
      "then": {
        "properties": {
          "backupRole": {
            "const": "cleanup-participant"
          }
        },
        "required": ["backupRole"]
      }
    }
  ],
  "properties": {
    "category": {
      "type": "string",
      "enum": ["api", "frontend", "backend", "test", "job", "static"]
    },
    "backupRole": {
      "description": "Backup-cleanup role for API/backend projects; required for these categories.",
      "type": "string",
      "enum": [
        "authoritative-read-only",
        "cleanup-participant",
        "derived-stateless",
        "excluded-external-cache"
      ]
    },
    "backupCompact": {
      "description": "Opt a cleanup participant into image compaction for its surviving recipe IDs; defaults to false.",
      "type": "boolean"
    },
    "graphqlSchema": {
      "type": "string",
      "minLength": 1
    },
    "dockerContext": {
      "type": "string",
      "minLength": 1
    },
    "tailwindSources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generate": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "output"],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "output": {
            "type": "string",
            "minLength": 1,
            "description": "Project-relative file glob; ** matches zero or more directories."
          }
        }
      }
    },
    "format": {
      "type": "string"
    },
    "check": {
      "type": "string"
    },
    "test": {
      "type": "string"
    },
    "prettier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ignore": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
