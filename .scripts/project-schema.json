{
  "$id": "https://example.com/language.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["category"],
  "properties": {
    "category": {
      "type": "string",
      "enum": ["api", "frontend", "backend", "test", "job", "static"]
    },
    "graphqlSchema": {
      "type": "string",
      "minLength": 1
    },
    "dockerContext": {
      "type": "string",
      "minLength": 1
    },
    "tailwindSources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generate": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "output"],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "output": {
            "type": "string",
            "minLength": 1,
            "description": "Project-relative file glob; ** matches zero or more directories."
          }
        }
      }
    },
    "format": {
      "type": "string"
    },
    "check": {
      "type": "string"
    },
    "test": {
      "type": "string"
    },
    "prettier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ignore": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
