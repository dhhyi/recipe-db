load(":action.bzl", "cache_action")

cache_action(
    name = "shared",
    src = "shared.txt",
)

cache_action(
    name = "main",
    src = "main.txt",
    executable = True,
)

cache_action(
    name = "pr",
    src = "pr.txt",
)

genrule(
    name = "combined",
    srcs = [":shared", ":main", ":pr"],
    outs = ["combined.out"],
    cmd = "cat $(SRCS) > $@",
)
