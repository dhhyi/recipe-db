#!/usr/bin/env bats

load test_helper

setup() {
  setup_fixture sync-tailwind.sh
  mkdir -p .scripts/lib
  cp "$BATS_TEST_DIRNAME/../lib/ignore-rules.sh" .scripts/lib/
  use_mise_tools
  mkdir -p design/src example/templates
  printf '%s\n' 'root-secret' '.dockerignore' '.update_devcontainer.sh' '*.log' > .gitignore
  printf '%s\n' 'src/tailwind-sources.css' > design/.gitignore
  touch design/src/component.html design/outside.html
  cat > design/.project.yaml << 'EOF'
name: design
---
tailwind:
  sources:
    - src/component.html
    - outside.html
docker:
  ignore: [src/tests, "!src/tests/keep.ts"]
EOF
  cat > example/.project.yaml << 'EOF'
name: example
---
tailwind:
  sources:
    - templates
  ignore:
    - templates/**/*_test.go
    - templates/generated/
EOF
  cat > design/Dockerfile << 'EOF'
FROM scratch
# BEGIN generated Tailwind Docker inputs
COPY obsolete /obsolete
# END generated Tailwind Docker inputs
RUN echo preserved
EOF
}

@test "resolves stylesheet-relative paths and copies only other projects into Docker" {
  run sh .scripts/sync-tailwind.sh

  [ "$status" -eq 0 ]
  cat > expected.css << 'EOF'
/* This file is generated by sync-tailwind.sh. Do not edit it manually. */

@source "../../example/templates";
@source "../outside.html";
@source "component.html";
@source not "../../example/templates/**/*_test.go";
@source not "../../example/templates/generated";
EOF
  cmp expected.css design/src/tailwind-sources.css
  grep -Fx 'COPY ["example/templates","/example/templates"]' design/Dockerfile
  run -1 grep -F obsolete design/Dockerfile
  run -1 grep -F 'COPY ["design/' design/Dockerfile
  grep -Fx 'FROM scratch' design/Dockerfile
  grep -Fx 'RUN echo preserved' design/Dockerfile
  grep -Fx '/example/*' design/Dockerfile.dockerignore
  grep -Fx '!/example/templates/**' design/Dockerfile.dockerignore
  grep -Fx '/example/templates/**/*_test.go' design/Dockerfile.dockerignore
  grep -Fx '/example/templates/generated' design/Dockerfile.dockerignore
  grep -Fx 'root-secret' design/Dockerfile.dockerignore
  grep -Fx '/design/root-secret' design/Dockerfile.dockerignore
  grep -Fx '/design/.dockerignore' design/Dockerfile.dockerignore
  grep -Fx '/design/.update_devcontainer.sh' design/Dockerfile.dockerignore
  grep -Fx '/design/*.log' design/Dockerfile.dockerignore
  grep -Fx '/design/src/tests' design/Dockerfile.dockerignore
  grep -Fx '!/design/src/tests/keep.ts' design/Dockerfile.dockerignore
  grep -Fx '/design/.project.yaml' design/Dockerfile.dockerignore
  grep -Fx '/design/.gitignore' design/Dockerfile.dockerignore
  grep -Fx '/design/README.md' design/Dockerfile.dockerignore
  grep -Fx '/design/Dockerfile' design/Dockerfile.dockerignore
  run -1 grep -Fx '/design/src/tailwind-sources.css' design/Dockerfile.dockerignore
}

@test "rejects source paths escaping the project without changing outputs" {
  cp design/Dockerfile expected.Dockerfile
  printf '%s\n' sentinel > design/src/tailwind-sources.css
  printf '%s\n' sentinel > design/Dockerfile.dockerignore
  for source in /tmp ../outside templates/../outside templates/.. ..; do
    printf 'name: example\n---\ntailwind:\n  sources:\n    - %s\n' "$source" > example/.project.yaml

    run --separate-stderr sh .scripts/sync-tailwind.sh

    [ "$status" -eq 1 ]
    [ "$stderr" = "Tailwind source $source must be inside project example" ]
    cmp expected.Dockerfile design/Dockerfile
    [ "$(cat design/src/tailwind-sources.css)" = sentinel ]
    [ "$(cat design/Dockerfile.dockerignore)" = sentinel ]
  done
}

@test "rejects missing sources" {
  printf '%s\n' 'name: example' '---' 'tailwind: {sources: [missing]}' > example/.project.yaml

  run --separate-stderr sh .scripts/sync-tailwind.sh

  [ "$status" -eq 1 ]
  [ "$stderr" = "Tailwind source example/missing must be an existing file or directory" ]
  [ ! -e design/src/tailwind-sources.css ]
}

@test "rejects invalid ignore patterns without changing outputs" {
  cp design/Dockerfile expected.Dockerfile
  printf '%s\n' sentinel > design/src/tailwind-sources.css
  printf '%s\n' sentinel > design/Dockerfile.dockerignore
  for pattern in '' /outside ../outside templates/../outside '!templates/keep' 'templates/[abc]'; do
    printf 'name: example\n---\ntailwind:\n  ignore:\n    - "%s"\n' "$pattern" > example/.project.yaml

    run sh .scripts/sync-tailwind.sh

    [ "$status" -eq 1 ]
    [[ $output == *"Tailwind "* ]]
    cmp expected.Dockerfile design/Dockerfile
    [ "$(cat design/src/tailwind-sources.css)" = sentinel ]
    [ "$(cat design/Dockerfile.dockerignore)" = sentinel ]
  done
}

@test "source validation does not write generated files and reports malformed metadata" {
  cp design/Dockerfile expected.Dockerfile
  run sh .scripts/sync-tailwind.sh --check-sources
  [ "$status" -eq 0 ]
  [ ! -e design/src/tailwind-sources.css ]
  cmp expected.Dockerfile design/Dockerfile

  printf '%s\n' '[' > example/.project.yaml
  run sh .scripts/sync-tailwind.sh --check-sources
  [ "$status" -ne 0 ]
  [ ! -e design/src/tailwind-sources.css ]
  cmp expected.Dockerfile design/Dockerfile
}

@test "fails on missing or duplicate Docker markers without replacing the Dockerfile" {
  for markers in missing duplicate; do
    if [ "$markers" = missing ]; then
      printf '%s\n' 'FROM scratch' > design/Dockerfile
    else
      cat > design/Dockerfile << 'EOF'
FROM scratch
# BEGIN generated Tailwind Docker inputs
# END generated Tailwind Docker inputs
# BEGIN generated Tailwind Docker inputs
# END generated Tailwind Docker inputs
EOF
    fi
    cp design/Dockerfile expected.Dockerfile

    run --separate-stderr sh .scripts/sync-tailwind.sh

    [ "$status" -eq 1 ]
    [ "$stderr" = "expected exactly one marker pair in design/Dockerfile" ]
    cmp expected.Dockerfile design/Dockerfile
  done
}
